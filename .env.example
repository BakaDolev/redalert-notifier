# Telegram API credentials — get from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Group to monitor — invite hash (from t.me/+XXXXX link) or numeric chat ID
TELEGRAM_GROUP=+ABCDefgh12345678

# n8n webhook URL — receives JSON payloads for matched alerts
N8N_WEBHOOK_URL=http://localhost:5678/webhook/telegram-alerts

# Test mode — also listen to a test group for debugging
TEST=false
TEST_GROUP=+ABCDefgh87654321
